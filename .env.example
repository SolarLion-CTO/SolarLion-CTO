# Supabase project settings (Project Settings -> API). Copy to .env.local for local dev,
# and add the same two variables in Vercel -> Project -> Settings -> Environment Variables.
# Leave them empty to run the site without login (demo mode).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
